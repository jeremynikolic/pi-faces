{
  "name": "pi-faces",
  "version": "0.1.0",
  "description": "Faces your pi agent can wear — bundle description, model, provider, thinking, tools, and system prompt into a named JSON profile selected via --profile",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/jeremynikolic/pi-faces/main/art/preview.png"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@types/node": "22.10.2",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6 <0.81.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
